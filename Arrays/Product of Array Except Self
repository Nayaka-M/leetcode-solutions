import java.util.*;
class Main 
{
    public static void main(String args[])
    {
        Scanner sc=new Scanner(System.in);
        int arr[]=new int[5];
        int ans[]=new int[5];
        int left=1;
        int right=1;
        for(int i=0;i<arr.length;i++)
        {
            arr[i]=sc.nextInt();
        }
        for(int i=0;i<arr.length;i++)
        {
            ans[i]=left;
            left=left*arr[i];
        }
        for(int i=arr.length-1;i>=0;i--)
        {
            ans[i]=ans[i]*right;
            right=right*arr[i];
        }
        for(int i=0;i<arr.length;i++)
        {
            System.out.print(ans[i]+" ");
        }
    }
}
