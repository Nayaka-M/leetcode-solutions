import java.util.*;
class Main 
{
    public static void main(String args[])
    {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        int count=0;
        int min=Integer.MAX_VALUE;
        for(int i=0;i<n;i++)
        {
            arr[i]=sc.nextInt();
        }
         int target=sc.nextInt();
        for(int i=0;i<n;i++)
        {
            int sum=0;
            for(int j=i;j<n;j++)
            {
             sum=sum+arr[j];
             if(sum>=target)
             {
                 int length=j-i+1;
             if(length<min)
             {
                 min=length;
             }
             break;
            }
           
            }
        }
         if(min==Integer.MAX_VALUE)
            {
                System.out.print("0");
            }
            else{
                System.out.print(min);
            }
    }
}

