import java.util.*;
class Main 
{
    public static void main(String args[])
    {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        int count=0;
        // int k=sc.nextInt();
        for(int i=0;i<arr.length;i++)
        {
            arr[i]=sc.nextInt();
        }
          int k=sc.nextInt();
       for(int i=0;i<n;i++)
       {
           int sum=0;
           for(int j=i;j<n;j++)
           {
               sum=sum+arr[j];
               if(sum==k)
               {
                   count++;
               }
            //   System.out.print(count);
           }
            // System.out.print(count);
       }
        System.out.print(count);
    }
}
