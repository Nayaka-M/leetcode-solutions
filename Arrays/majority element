import java.util.*;
class Main 
{
    public static void main(String args[])
    {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++)
        {
            arr[i]=sc.nextInt();
        }
        int canditate=0;
        int count=0;
        for(int i=0;i<n;i++)
        {
          if(count==0)
          {
             canditate =arr[i];
          }
          if(arr[i]==canditate)
          {
              count++;
          }
          else
          {
              count--;
          }
        }
        System.out.print(canditate);
    }
}
